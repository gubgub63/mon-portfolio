---
import '../styles/global.css';
import Icon from '../components/Icon.astro';
import { sitePath } from '../lib/paths';

interface Props {
    mode?: 'developer' | 'trail';
    lang?: 'en' | 'fr';
    title?: string;
    description?: string;
}

const {
    mode = 'developer',
    lang = 'en',
    title = 'Enzo — Full-Stack Developer',
    description = 'Full-stack developer at Accenture. Web applications, e-commerce, data engineering and a love for the trails.',
} = Astro.props;
const isTrail = mode === 'trail';
const isFrench = lang === 'fr';
const homePath = isFrench ? '/fr/' : '/';
const trailPath = isFrench ? '/fr/trail/' : '/trail/';
const pagePath = isTrail ? trailPath : homePath;
const navigation = isTrail
    ? [
          { href: `${trailPath}#results`, label: isFrench ? 'Résultats' : 'Results' },
          { href: `${trailPath}#goals`, label: isFrench ? 'Objectifs 2027' : '2027 goals' },
          { href: `${trailPath}#story`, label: isFrench ? 'Mon histoire' : 'My story' },
      ]
    : [
          { href: `${homePath}#projects`, label: isFrench ? 'Projets' : 'Projects' },
          { href: `${homePath}#experience`, label: isFrench ? 'Parcours' : 'Experience' },
          { href: `${homePath}#highlights`, label: isFrench ? 'À la une' : 'Highlights' },
      ];
const contactHref = `${pagePath}#contact`;
const absoluteUrl = (path: string) => new URL(sitePath(path), Astro.site || Astro.url).href;
---

<!doctype html>
<html lang={lang}>
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <meta name="description" content={description} />
        <meta name="theme-color" content="#ffffff" />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:type" content="website" />
        <link rel="canonical" href={absoluteUrl(pagePath)} />
        <link rel="alternate" hreflang="en" href={absoluteUrl(isTrail ? '/trail/' : '/')} />
        <link rel="alternate" hreflang="fr" href={absoluteUrl(isTrail ? '/fr/trail/' : '/fr/')} />
        <link rel="icon" href={sitePath('/favicon.svg')} />
        <title>{title}</title>
        <script is:inline>
            try {
                if (localStorage.getItem('theme') === 'dark')
                    document.documentElement.dataset.theme = 'dark';
            } catch {}
        </script>
    </head>
    <body class:list={{ 'trail-mode': isTrail }}>
        <a class="skip-link" href="#main">
            {isFrench ? 'Aller au contenu' : 'Skip to content'}
        </a>
        <header class="site-header">
            <nav
                class="shell nav"
                aria-label={isFrench ? 'Navigation principale' : 'Main navigation'}
            >
                <div class="nav-identity">
                    <a
                        class="wordmark"
                        href={sitePath(homePath)}
                        aria-label={isFrench ? 'Accueil Enzo' : 'Enzo home'}
                    >
                        ENZO
                    </a>
                    <div
                        class="mode-switch"
                        role="group"
                        aria-label={
                            isFrench ? 'Explorer mes deux univers' : 'Explore my two worlds'
                        }
                    >
                        <a href={sitePath(homePath)} aria-current={!isTrail ? 'page' : undefined}>
                            <Icon name="code" size={14} /> {isFrench ? 'Développeur' : 'Developer'}
                        </a>
                        <a href={sitePath(trailPath)} aria-current={isTrail ? 'page' : undefined}>
                            <Icon name="mountain" size={14} /> Trail
                        </a>
                    </div>
                </div>
                <div class="nav-links">
                    {navigation.map((item) => (
                        <a class="section-nav-link" href={sitePath(item.href)}>
                            {item.label}
                        </a>
                    ))}
                    <span class="nav-divider"></span>
                    <div
                        class="language-switch"
                        role="group"
                        aria-label={isFrench ? 'Langue du site' : 'Site language'}
                    >
                        <a
                            href={sitePath(isTrail ? '/trail/' : '/')}
                            lang="en"
                            hreflang="en"
                            aria-current={!isFrench ? 'true' : undefined}
                        >
                            EN
                        </a>
                        <span aria-hidden="true">/</span>
                        <a
                            href={sitePath(isTrail ? '/fr/trail/' : '/fr/')}
                            lang="fr"
                            hreflang="fr"
                            aria-current={isFrench ? 'true' : undefined}
                        >
                            FR
                        </a>
                    </div>
                    <button
                        id="theme-toggle"
                        class="icon-button"
                        aria-label={isFrench ? 'Activer le thème sombre' : 'Switch to dark theme'}
                        aria-pressed="false"
                    >
                        <span class="sun-icon">
                            <Icon name="sun" size={16} />
                        </span>
                        <span class="moon-icon">
                            <Icon name="moon" size={16} />
                        </span>
                    </button>
                </div>
            </nav>
        </header>
        <main id="main" class="shell">
            <slot />
        </main>
        <footer class="shell site-footer">
            <div>
                <p class="footer-thought">
                    {isTrail
                        ? isFrench
                            ? 'Des volcans. Vers de nouveaux horizons.'
                            : 'From the volcanoes. Towards something bigger.'
                        : isFrench
                          ? 'Toujours avancer. Toujours progresser.'
                          : 'One step further. One iteration better.'}
                </p>
                <p>
                    Enzo <span>/</span>{' '}
                    {isTrail
                        ? isFrench
                            ? 'Toujours en mouvement'
                            : 'Always moving'
                        : isFrench
                          ? 'Toujours apprendre'
                          : 'Always learning'}{' '}
                    <span>/</span> {isTrail ? 'Puy-de-Dôme, FR' : 'France'}
                </p>
            </div>
            <a
                href={
                    isTrail
                        ? 'https://utmb.world/fr/runner/7379898.enzo.gubbiotti'
                        : 'https://github.com/gubgub63'
                }
                target="_blank"
                rel="noreferrer"
                aria-label={
                    isTrail
                        ? isFrench
                            ? 'Enzo sur UTMB'
                            : 'Enzo on UTMB'
                        : isFrench
                          ? 'Enzo sur GitHub'
                          : 'Enzo on GitHub'
                }
            >
                <Icon name={isTrail ? 'mountain' : 'github'} />
            </a>
        </footer>
        <a class="floating-contact" href={sitePath(contactHref)}>
            <Icon name="chat" size={17} /> {isFrench ? 'On échange ?' : "Let's talk"}
        </a>
        <script>
            const isFrench = document.documentElement.lang === 'fr';
            const button = document.querySelector<HTMLButtonElement>('#theme-toggle');
            function syncTheme() {
                const dark = document.documentElement.dataset.theme === 'dark';
                button?.setAttribute('aria-pressed', String(dark));
                button?.setAttribute(
                    'aria-label',
                    isFrench
                        ? `Activer le thème ${dark ? 'clair' : 'sombre'}`
                        : `Switch to ${dark ? 'light' : 'dark'} theme`,
                );
                document
                    .querySelector('meta[name="theme-color"]')
                    ?.setAttribute('content', dark ? '#101113' : '#ffffff');
            }
            syncTheme();
            button?.addEventListener('click', () => {
                const theme = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
                document.documentElement.dataset.theme = theme;
                try {
                    localStorage.setItem('theme', theme);
                } catch {}
                syncTheme();
            });
            const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
            if (!reduce.matches && 'IntersectionObserver' in window) {
                const observer = new IntersectionObserver(
                    (entries) =>
                        entries.forEach((entry) => {
                            if (entry.isIntersecting) {
                                entry.target.animate(
                                    [
                                        { opacity: 0.55, transform: 'translateY(12px)' },
                                        { opacity: 1, transform: 'translateY(0)' },
                                    ],
                                    { duration: 550, easing: 'cubic-bezier(.16,1,.3,1)' },
                                );
                                observer.unobserve(entry.target);
                            }
                        }),
                    { threshold: 0.08 },
                );
                document.querySelectorAll('[data-reveal]').forEach((el) => observer.observe(el));
            }
        </script>
    </body>
</html>
