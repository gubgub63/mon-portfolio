---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import PixelPortrait from '../components/PixelPortrait.astro';
import GitHubActivity from '../components/GitHubActivity.astro';
import { profile, experience, stackGroups, projects } from '../data/profile';
const email = profile.email;
const featured = projects.slice(0, 2);
const projectCards = projects.filter((project) => !featured.includes(project));
const techColor: Record<string, string> = {
    React: '#149eca',
    Angular: '#d32f49',
    Vue: '#25986b',
    Astro: '#b047c8',
    PHP: '#787cb5',
    Java: '#d08035',
    WordPress: '#21759b',
    WooCommerce: '#96588a',
    Python: '#387bab',
    Docker: '#2496ed',
    Git: '#f05032',
    TypeScript: '#3178c6',
};
---

<Layout title="Enzo Gubbiotti — Full-Stack Developer">
    <section class="hero">
        <div class="identity">
            <PixelPortrait alt="Enzo's GitHub avatar" />
            <div>
                <h1>{profile.name}</h1>
                <div class="socials">
                    <a
                        href={profile.github}
                        target="_blank"
                        rel="noreferrer"
                        aria-label="GitHub profile"
                    >
                        <Icon name="github" size={20} />
                    </a>
                    <a href={`mailto:${email}`} aria-label="Email Enzo">
                        <Icon name="mail" size={20} />
                    </a>
                </div>
            </div>
        </div>
        <h2 class="hero-role">
            Full-Stack Developer <span>— Web & E-commerce</span>
        </h2>
        <p class="intro">
            I'm a full-stack developer building web applications and e-commerce experiences with{' '}
            <span class="inline-tech">
                <Icon name="code" size={13} /> Java
            </span>{' '}
            <span class="inline-tech">
                <Icon name="code" size={13} /> Angular
            </span>{' '}
            <span class="inline-tech">
                <Icon name="code" size={13} /> PHP
            </span>{' '}
            <span class="inline-tech">
                <Icon name="code" size={13} /> WordPress
            </span>
            . Currently at <strong>Accenture</strong>, I'm also exploring data engineering and
            building tools inspired by life on the trails.
        </p>
        <a class="button primary" href="#experience">
            View my experience <Icon name="chevron" size={14} />
        </a>
    </section>
    <section id="experience" data-reveal>
        <div class="section-heading">
            <h2>Experience</h2>
            <button
                class="text-link"
                id="experience-toggle"
                aria-expanded="false"
                aria-controls="experience-list"
            >
                View details <Icon name="chevron" size={14} />
            </button>
        </div>
        <div class="timeline" id="experience-list">
            {experience
                .filter((e) => e.company !== 'Education')
                .map((item) => (
                    <article class="timeline-row">
                        <p class="period">{item.period}</p>
                        <div>
                            <h3>{item.role}</h3>
                            <p class="company">{item.company}</p>
                            <p class="subtle">
                                {item.current
                                    ? 'Permanent contract · France'
                                    : 'WordPress & WooCommerce'}
                            </p>
                            <p class="experience-detail" hidden>
                                {item.description}
                            </p>
                        </div>
                    </article>
                ))}
        </div>
    </section>
    <section id="highlights" data-reveal>
        <div class="section-heading">
            <h2>Featured Work</h2>
        </div>
        <div class="featured-gallery">
            {featured.map((project, i) => (
                <a
                    class:list={['featured-panel', { active: i === 0 }]}
                    href={project.website || project.repo}
                    target="_blank"
                    rel="noreferrer"
                >
                    <img
                        src={project.featureImage || '/images/trail-mountains.jpg'}
                        alt=""
                        width="720"
                        height="480"
                        loading="lazy"
                    />
                    <div class="featured-shade"></div>
                    <div class="featured-content">
                        <span class="feature-type">Personal project</span>
                        <h3>{project.title}</h3>
                        <p>{project.summary}</p>
                        <span class="feature-link">
                            Explore project <Icon name="arrow" size={14} />
                        </span>
                    </div>
                </a>
            ))}
        </div>
    </section>
    <section id="projects" data-reveal>
        <div class="section-heading">
            <h2>Projects</h2>
        </div>
        <div class="project-grid">
            {projectCards.map((project) => (
                <article class="project-card">
                    <a
                        href={project.repo}
                        class:list={['project-visual', `project-visual-${project.slug}`]}
                        target="_blank"
                        rel="noreferrer"
                        aria-label={`Explore ${project.title} on GitHub`}
                    >
                        {project.slug === 'pykemon' ? (
                            <img
                                src="/images/pykemon-map.png"
                                alt="Pykemon game map"
                                width="400"
                                height="300"
                                loading="lazy"
                            />
                        ) : (
                            <>
                                <Icon name="code" size={34} />
                                <span>{project.title}</span>
                            </>
                        )}
                    </a>
                    <div class="project-copy">
                        <h3>
                            <a href={project.repo} target="_blank" rel="noreferrer">
                                {project.title}
                            </a>
                        </h3>
                        <p class="project-role">
                            {project.slug === 'dansenity'
                                ? 'Full-stack platform'
                                : 'Personal project'}
                        </p>
                        <p>{project.description}</p>
                        <div class="project-tech">
                            {project.technologies.slice(0, 3).map((t) => (
                                <span>{t}</span>
                            ))}
                        </div>
                        <a
                            class="project-link"
                            href={project.repo}
                            target="_blank"
                            rel="noreferrer"
                        >
                            View repository <Icon name="arrow" size={13} />
                        </a>
                    </div>
                </article>
            ))}
        </div>
        <a
            class="button all-projects"
            href={`${profile.github}?tab=repositories`}
            target="_blank"
            rel="noreferrer"
        >
            Explore all projects <Icon name="chevron" size={15} />
        </a>
    </section>
    <section id="technologies" data-reveal>
        <div class="section-heading">
            <h2>Technologies</h2>
            <button
                id="tech-toggle"
                class="text-link"
                aria-expanded="false"
                aria-controls="all-technologies"
            >
                View all <Icon name="chevron" size={14} />
            </button>
        </div>
        <button id="motion-toggle" class="text-link motion-toggle" aria-pressed="false">
            Pause animation
        </button>
        <div class="tech-marquees">
            {[
                stackGroups[0].items,
                [...stackGroups[1].items, 'Python', 'SQL'],
                ['Git', 'Docker', ...stackGroups[2].items],
            ].map((items, row) => (
                <div
                    class="marquee"
                    aria-label={
                        ['Frontend technologies', 'Backend technologies', 'Tools and e-commerce'][
                            row
                        ]
                    }
                >
                    <div class:list={['marquee-track', { reverse: row === 1 }]}>
                        {[0, 1].map((copy) => (
                            <div
                                class="marquee-group"
                                aria-hidden={copy === 1 ? 'true' : undefined}
                            >
                                {items.map((t) => (
                                    <span class="tech-chip">
                                        <span style={`color:${techColor[t] || 'var(--muted)'}`}>
                                            <Icon name="code" size={14} />
                                        </span>
                                        {t}
                                    </span>
                                ))}
                            </div>
                        ))}
                    </div>
                </div>
            ))}
        </div>
        <div id="all-technologies" class="all-technologies" hidden>
            {stackGroups.map((group) => (
                <div>
                    <h3>{group.label}</h3>
                    <p>{group.items.join(' · ')}</p>
                </div>
            ))}
        </div>
    </section>
    <section id="education" data-reveal>
        <div class="section-heading">
            <h2>Education</h2>
        </div>
        <div class="timeline-row">
            <p class="period">Graduated</p>
            <div>
                <h3>BUT in Computer Science</h3>
                <p class="subtle">Bachelor Universitaire de Technologie · Informatique</p>
                <p class="subtle">Software development & hands-on projects</p>
            </div>
        </div>
    </section>
    <section id="outside" data-reveal>
        <div class="section-heading">
            <h2>Outside the IDE</h2>
        </div>
        <div class="outside-grid">
            <div>
                <p class="body-copy">
                    Away from the keyboard, you'll find me on the trails. The climbs, the quiet, and
                    the long runs give me a fresh perspective — and inspire the tools I build when
                    I'm back.
                </p>
                <div class="interest-tags">
                    <span>Trail running</span>
                    <span>Ultra-trail</span>
                    <span>The outdoors</span>
                </div>
                <a class="text-link trail-entry" href="/trail/">
                    Explore my trail side <Icon name="arrow" size={15} />
                </a>
            </div>
            <button class="photo-stack" aria-label="Show next trail inspiration photograph">
                <img
                    src="/images/trail-forest.jpg"
                    alt="A quiet forest in the mountains"
                    width="224"
                    height="224"
                    loading="lazy"
                />
                <img
                    src="/images/trail-hiking.jpg"
                    alt="Hikers following a mountain trail"
                    width="224"
                    height="224"
                    loading="lazy"
                />
                <img
                    src="/images/trail-mountains.jpg"
                    alt="Mountain peaks above the trails"
                    width="224"
                    height="224"
                    loading="lazy"
                />
                <span class="photo-hint">
                    A little perspective <Icon name="arrow" size={12} />
                </span>
            </button>
        </div>
    </section>
    <GitHubActivity />
    <section id="contact" data-reveal>
        <div class="section-heading">
            <h2>Let's work together.</h2>
        </div>
        <div class="contact-grid">
            <p class="body-copy">
                Have a web project in mind, a technical challenge, or a trail recommendation? I'd
                love to hear about it. Let's start a conversation.
            </p>
            <div class="contact-links">
                <a class="contact-card" href={`mailto:${email}`}>
                    <span class="contact-icon">
                        <Icon name="mail" />
                    </span>
                    <span>
                        <small>Email</small>
                        <span>{email}</span>
                    </span>
                    <Icon name="chevron" size={16} />
                </a>
                <a class="contact-card" href={profile.github} target="_blank" rel="noreferrer">
                    <span class="contact-icon">
                        <Icon name="github" />
                    </span>
                    <span>
                        <small>Find me on GitHub</small>
                        <span>@{profile.handle}</span>
                    </span>
                    <Icon name="arrow" size={16} />
                </a>
            </div>
        </div>
    </section>
    <script>
        for (const [trigger, target] of [
            ['experience-toggle', 'experience-list'],
            ['tech-toggle', 'all-technologies'],
        ]) {
            const button = document.getElementById(trigger);
            const panel = document.getElementById(target);
            button?.addEventListener('click', () => {
                const open = button.getAttribute('aria-expanded') !== 'true';
                button.setAttribute('aria-expanded', String(open));
                if (target === 'experience-list')
                    panel
                        ?.querySelectorAll<HTMLElement>('.experience-detail')
                        .forEach((el) => (el.hidden = !open));
                else if (panel) panel.hidden = !open;
                button.childNodes[0].textContent = open
                    ? 'Show less '
                    : 'View ' + (target === 'experience-list' ? 'details ' : 'all ');
            });
        }
        document.getElementById('motion-toggle')?.addEventListener('click', (event) => {
            const button = event.currentTarget as HTMLButtonElement;
            const paused = button.getAttribute('aria-pressed') !== 'true';
            button.setAttribute('aria-pressed', String(paused));
            button.textContent = paused ? 'Play animation' : 'Pause animation';
            document.querySelector('.tech-marquees')?.classList.toggle('paused', paused);
        });
        const panels = document.querySelectorAll('.featured-panel');
        panels.forEach((panel) => {
            const activate = () =>
                panels.forEach((el) => el.classList.toggle('active', el === panel));
            panel.addEventListener('pointerenter', activate);
            panel.addEventListener('focus', activate);
        });
        const stack = document.querySelector('.photo-stack');
        stack?.addEventListener('click', () => {
            const photos = stack.querySelectorAll('img');
            if (photos.length) stack.insertBefore(photos[photos.length - 1], photos[0]);
        });
    </script>
</Layout>
