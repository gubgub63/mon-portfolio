---
import ProjectCard from './ProjectCard.astro'
interface Item { title: string; description: string; tags?: string[]; link?: string; repo?: string; image?: string }
const { items = [] } = Astro.props as { items: Item[] }
---
<section id="projects" class="pt-6 md:pt-10">
  <div class="reveal flex items-center justify-between">
    <h2 class="section-title text-gradient">Projets récents</h2>
    <div class="flex gap-2 items-center">
      <button id="prev" class="btn disabled:opacity-40 disabled:cursor-not-allowed" aria-label="Précédent" aria-controls="rail">←</button>
      <button id="next" class="btn disabled:opacity-40 disabled:cursor-not-allowed" aria-label="Suivant" aria-controls="rail">→</button>
    </div>
  </div>

  <div class="reveal mt-4 overflow-x-auto" id="rail">
    <div class="flex gap-4 pr-6 snap-x snap-mandatory">
      {items.map((p) => (
        <div class="snap-start shrink-0 w-[280px] md:w-[320px]" data-card>
          <ProjectCard {...p} />
        </div>
      ))}
    </div>
  </div>

  <script is:inline>
    (()=>{
      const rail = document.getElementById('rail')
      if(!rail) return
      const prev = document.getElementById('prev')
      const next = document.getElementById('next')
      let isAnimating = false
      const maxScroll = () => rail.scrollWidth - rail.clientWidth
      const update = () => {
        const max = maxScroll()
        if (prev) prev.disabled = rail.scrollLeft <= 2
        if (next) next.disabled = rail.scrollLeft >= max - 2
      }
      const cards = Array.from(rail.querySelectorAll('[data-card]'))
      const cardWidth = () => cards[0] ? (cards[0].clientWidth + 16) : 320
      const scrollToSnap = (dir) => {
        if (isAnimating) return
        const cw = cardWidth()
        const target = rail.scrollLeft + dir * cw
        isAnimating = true
        rail.scrollTo({ left: target, behavior: 'smooth' })
        setTimeout(()=> { isAnimating = false; update() }, 420)
      }
      prev?.addEventListener('click', ()=> scrollToSnap(-1))
      next?.addEventListener('click', ()=> scrollToSnap(1))
      rail.addEventListener('scroll', ()=> { if(!isAnimating) update() })
      window.addEventListener('resize', ()=> { update() })
      update()
    })()
  </script>
</section>
