---
---
<section id="contact" class="pt-16 pb-24">
  <div class="reveal card glass">
    <h2 class="section-title">On construit quelque chose ?</h2>
    <p class="text-[rgb(var(--muted))] mt-2">Parlez-moi de votre idée (objectif, budget, délais). Réponse en 24h.</p>
    <form action="mailto:contact@example.com" method="post" class="mt-4 grid gap-3 md:grid-cols-2">
      <input required name="name" placeholder="Votre nom" class="border border-white/15 bg-transparent rounded-xl px-4 py-2 outline-none" />
      <input required name="email" type="email" placeholder="Votre e-mail" class="border border-white/15 bg-transparent rounded-xl px-4 py-2 outline-none" />
      <input name="subject" placeholder="Sujet" class="md:col-span-2 border border-white/15 bg-transparent rounded-xl px-4 py-2 outline-none" />
      <textarea required name="message" placeholder="Votre message" class="md:col-span-2 h-28 border border-white/15 bg-transparent rounded-xl px-4 py-2 outline-none"></textarea>
      <button class="btn btn-primary md:col-span-2 w-max">Envoyer</button>
    </form>
  </div>
</section>
