---
import '../styles/global.css'
const { title = 'Enzo · Développeur', description = 'Portfolio — backend → full-stack. Symfony, WordPress, Astro.', ogImage = '/assets/astro.svg' } = Astro.props as any
---
<!doctype html>
<html lang="fr" class="bg-[rgb(var(--bg))] text-[rgb(var(--fg))]">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <link rel="icon" type="image/svg+xml" href="/assets/astro.svg" />
    <title>{title}</title>
  </head>
  <body>
    <div id="root-bg"></div>
    <header class="container-px sticky top-0 z-40 backdrop-blur supports-[backdrop-filter]:bg-white/5">
      <nav class="mx-auto max-w-6xl flex items-center justify-between py-3">
        <a href="#top" class="font-semibold tracking-tight">enzo.dev</a>
        <div class="hidden sm:flex items-center gap-2">
          <a href="#about" class="btn">À propos</a>
          <a href="#services" class="btn">Services</a>
          <a href="#projects" class="btn">Projets</a>
          <a href="#process" class="btn">Process</a>
          <a href="#stack" class="btn">Stack</a>
          <a href="#contact" class="btn btn-primary">Contact</a>
        </div>
      </nav>
    </header>

    <main id="top" class="mx-auto max-w-6xl container-px">
      <slot />
    </main>

    <footer class="mx-auto max-w-6xl container-px py-12 footer">
      <div class="flex flex-col sm:flex-row items-center justify-between gap-4">
        <p>© {new Date().getFullYear()} Enzo — Tous droits réservés.</p>
        <p>Construit avec <span class="link-underline">Astro</span> & Tailwind.</p>
      </div>
    </footer>

    <script is:inline>
      // IntersectionObserver reveal
      const io = new IntersectionObserver((entries)=>{
        for (const e of entries) {
          if (e.isIntersecting) { e.target.classList.add('show'); io.unobserve(e.target); }
        }
      }, { threshold: .16 });
      document.querySelectorAll('.reveal').forEach(el=>io.observe(el));
    </script>
  </body>
</html>
