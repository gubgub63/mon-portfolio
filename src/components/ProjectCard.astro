---
export interface Props {
  title: string
  description: string
  tags?: string[]
  link?: string
  repo?: string
  image?: string
}
const { title, description, tags = [], link, repo, image = '' } = Astro.props as Props
const primaryLink = link || repo || ''
---
<article class="card glass flex flex-col gap-3">
  <img src={image} alt={title} class="w-full h-44 object-cover rounded-xl border border-white/15" loading="lazy" />
  <div class="flex items-start justify-between gap-2">
    <h3 class="font-semibold text-lg">{title}</h3>
    {repo && (<a href={repo} class="link-underline text-sm" target="_blank" rel="noopener">Code</a>)}
  </div>
  <p class="text-[rgb(var(--muted))] text-sm">{description}</p>
  {tags.length > 0 && (
    <ul class="mt-1 flex flex-wrap gap-2">
      {tags.map((t) => <li class="text-xs bg-white/5 border border-white/15 py-1 px-2 rounded-lg">{t}</li>)}
    </ul>
  )}
  {primaryLink && (<a href={primaryLink} class="btn mt-2 self-start" target="_blank" rel="noopener">Voir le projet →</a>)}
</article>
