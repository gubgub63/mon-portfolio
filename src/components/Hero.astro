---
const subtitle = 'Développeur backend (Symfony, WP), en route vers le full-stack. Je construis des apps rapides, propres et mesurables.'
---
<section class="relative pt-14 md:pt-24 pb-10 md:pb-20">
  <!-- floating blobs -->
  <div class="absolute inset-0 -z-10 pointer-events-none">
    <div class="blob absolute -top-12 left-[-10%] h-[420px] w-[420px] rounded-full bg-pink-500/40 animate-pulse"></div>
    <div class="blob absolute top-16 right-[-8%] h-[380px] w-[380px] rounded-full bg-blue-400/40 animate-pulse"></div>
  </div>

  <div class="reveal max-w-3xl">
    <h1 class="text-4xl md:text-6xl font-extrabold leading-tight">
      <span class="text-gradient">Construisons des choses utiles</span><br/>
      avec un code fiable.
    </h1>
    <p class="mt-4 text-[rgb(var(--muted))] text-lg">{subtitle}</p>

    <div class="mt-6 flex gap-3 flex-wrap">
      <a href="#projects" class="btn btn-primary">Voir mes projets</a>
      <a href="#contact" class="btn">Discuter d'un besoin</a>
    </div>
  </div>

  <!-- stats / quick facts card -->
  <div class="reveal card glass mt-10 grid grid-cols-2 sm:grid-cols-4 gap-4">
    <div>
      <p class="text-2xl font-bold">5+</p>
      <p class="text-[rgb(var(--muted))] text-sm">projets en prod</p>
    </div>
    <div>
      <p class="text-2xl font-bold">~99.9%</p>
      <p class="text-[rgb(var(--muted))] text-sm">uptime déployés</p>
    </div>
    <div>
      <p class="text-2xl font-bold"><code>Symfony</code></p>
      <p class="text-[rgb(var(--muted))] text-sm">cœur de métier</p>
    </div>
    <div>
      <p class="text-2xl font-bold">Astro</p>
      <p class="text-[rgb(var(--muted))] text-sm">site ultra-rapide ⚡️</p>
    </div>
  </div>
</section>
