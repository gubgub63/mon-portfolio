---
import { sitePath } from '../lib/paths';

interface Props {
    src?: string;
    alt?: string;
}

const { src = '/images/profile.png', alt = 'Profile portrait' } = Astro.props;
---

<pixel-portrait>
    <button
        class="portrait"
        type="button"
        aria-label="Toggle portrait color"
        aria-pressed="false"
        data-active="false"
    >
        <img
            src={sitePath(src)}
            alt={alt}
            width="160"
            height="160"
            fetchpriority="high"
            draggable="false"
        />
        <span class="pixels" aria-hidden="true">
            {Array.from({ length: 144 }, () => (
                <span class="pixel" />
            ))}
        </span>
    </button>
</pixel-portrait>

<style>
    pixel-portrait {
        display: block;
        flex-shrink: 0;
    }
    .portrait {
        position: relative;
        display: block;
        width: 128px;
        height: 128px;
        padding: 0;
        overflow: hidden;
        isolation: isolate;
        border: 2px solid var(--portrait-border, #d1d5db);
        border-radius: 50%;
        background: #e5e7eb;
        cursor: pointer;
        touch-action: manipulation;
        -webkit-tap-highlight-color: transparent;
    }
    .portrait:focus-visible {
        outline: 2px solid currentColor;
        outline-offset: 5px;
    }
    img {
        display: block;
        width: 100%;
        height: 100%;
        object-fit: cover;
        filter: grayscale(1);
    }
    .portrait[data-active='true'] img {
        filter: grayscale(0);
        transform: scale(1.1);
    }
    .pixels {
        position: absolute;
        inset: 0;
        display: grid;
        grid-template-columns: repeat(12, 1fr);
        grid-template-rows: repeat(12, 1fr);
        pointer-events: none;
    }
    .pixel {
        background: #fff;
        opacity: 0;
    }
    :global([data-theme='dark']) .portrait,
    :global(.dark) .portrait {
        --portrait-border: #4b5563;
    }
    @media (min-width: 640px) {
        .portrait {
            width: 160px;
            height: 160px;
        }
    }
</style>

<script>
    class PixelPortrait extends HTMLElement {
        private frame = 0;
        private target = false;
        private pinned = false;
        private controller?: AbortController;

        connectedCallback() {
            if (this.controller) return;
            this.controller = new AbortController();
            const { signal } = this.controller;
            const button = this.querySelector<HTMLButtonElement>('button')!;
            const pixels = Array.from(this.querySelectorAll<HTMLElement>('.pixel'));
            const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

            const clearPixels = () =>
                pixels.forEach((pixel) => {
                    pixel.style.opacity = '0';
                });
            const settle = () => {
                cancelAnimationFrame(this.frame);
                button.dataset.active = String(this.target);
                clearPixels();
            };

            const transition = (active: boolean) => {
                if (active === this.target) return;
                settle();
                this.target = active;
                if (reducedMotion.matches) {
                    settle();
                    return;
                }

                const order = pixels.map((_, index) => index);
                for (let index = order.length - 1; index > 0; index--) {
                    const random = Math.floor(Math.random() * (index + 1));
                    [order[index], order[random]] = [order[random], order[index]];
                }
                const start = performance.now();
                const animate = (now: number) => {
                    const elapsed = now - start;
                    if (elapsed >= 180) button.dataset.active = String(active);
                    order.forEach((index, rank) => {
                        const delay = (rank / order.length) * 180;
                        pixels[index].style.opacity =
                            elapsed >= delay && elapsed < 200 + delay ? '1' : '0';
                    });
                    if (elapsed < 400) this.frame = requestAnimationFrame(animate);
                    else settle();
                };
                this.frame = requestAnimationFrame(animate);
            };

            button.addEventListener(
                'pointerenter',
                (event) => {
                    if (event.pointerType !== 'touch') transition(true);
                },
                { signal },
            );
            button.addEventListener(
                'pointerleave',
                () => {
                    if (!this.pinned && !button.matches(':focus-visible')) transition(false);
                },
                { signal },
            );
            button.addEventListener(
                'focus',
                () => {
                    if (button.matches(':focus-visible')) transition(true);
                },
                { signal },
            );
            button.addEventListener(
                'blur',
                () => {
                    if (!this.pinned) transition(false);
                },
                { signal },
            );
            button.addEventListener(
                'click',
                () => {
                    this.pinned = !this.pinned;
                    button.setAttribute('aria-pressed', String(this.pinned));
                    transition(this.pinned);
                },
                { signal },
            );
            reducedMotion.addEventListener(
                'change',
                () => {
                    if (reducedMotion.matches) settle();
                },
                { signal },
            );
        }

        disconnectedCallback() {
            cancelAnimationFrame(this.frame);
            this.controller?.abort();
            this.controller = undefined;
        }
    }

    if (!customElements.get('pixel-portrait'))
        customElements.define('pixel-portrait', PixelPortrait);
</script>
