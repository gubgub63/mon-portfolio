---
// Placeholder – pourra être remplacé par du contenu réel.
const testimonials = [
  { a: 'Client SaaS', q: 'Livraison rapide, code clair et facile à reprendre. Les métriques de perf sont remontées dès J1.' },
  { a: 'Agence Web', q: 'Excellente communication, anticipation des risques et documentation synthétique.' },
]
---
<section id="temoignages" class="pt-16">
  <h2 class="reveal section-title">Témoignages</h2>
  <div class="reveal mt-4 grid-auto-fill">
    {testimonials.map(t => (
      <figure class="card glass flex flex-col gap-3">
        <blockquote class="text-sm leading-relaxed italic">“{t.q}”</blockquote>
        <figcaption class="text-[rgb(var(--muted))] text-xs">— {t.a}</figcaption>
      </figure>
    ))}
  </div>
</section>
