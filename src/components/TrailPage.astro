---
import TrailLayout from '../layouts/TrailLayout.astro';
import Icon from './Icon.astro';
import { profile } from '../data/profile';
import { trailGoals } from '../data/trail';
import { trailCopy, type Language } from '../data/trail-copy';
import trailResults from '../data/trail-results.json';
import TrailRoute from './TrailRoute.astro';
import RaceRoutes from './RaceRoutes.astro';
import { trailSocial } from '../data/trail-social';
import { sitePath } from '../lib/paths';
import { gr441Project } from '../data/gr441-project';

const { lang } = Astro.props as { lang: Language };
const copy = trailCopy[lang];
const goals = trailGoals
    .map((goal, index) => ({
        ...goal,
        ...copy.goals[index],
        partnership: copy.goalPartnerships[index],
    }))
    .sort((a, b) => Number(b.id === 'gr441') - Number(a.id === 'gr441'));
const partnershipHref = `mailto:${profile.email}?subject=${encodeURIComponent(copy.contactSubject)}&body=${encodeURIComponent(copy.contactBody)}`;
const indexLabels: Record<string, string> = {
    general: lang === 'fr' ? 'Général' : 'Overall',
    '20k': '20K',
    '50k': '50K',
    '100k': '100K',
    '100m': '100M',
};
const highlights = ['2026-08-08', '2026-06-12', '2025-10-11'].map((date, index) => ({
    ...trailResults.results.find((result) => result.dateIso === date)!,
    note: copy.highlights[index],
}));
const formatDate = (date: string) =>
    new Intl.DateTimeFormat(lang === 'fr' ? 'fr-FR' : 'en-GB', {
        day: 'numeric',
        month: 'short',
        year: 'numeric',
        timeZone: 'UTC',
    }).format(new Date(date));
const formatNumber = (number: number) =>
    new Intl.NumberFormat(lang === 'fr' ? 'fr-FR' : 'en-GB').format(number);
const formatPlacing = (place: string) =>
    lang === 'fr' ? ({ '1st': '1er', '2nd': '2e', '3rd': '3e' }[place] ?? place) : place;

const fr = lang === 'fr';
const projectNames: Record<string, string> = {
    gr441: 'GR441',
    miut: 'MIUT Legend',
    diagonale: 'Diagonale des Fous',
};
---

<TrailLayout lang={lang} title={copy.title} description={copy.description}>
    <section class="personal-hero trail-wrap" aria-labelledby="trail-title">
        <div class="personal-hero-copy">
            <h1 id="trail-title">
                <span class="name-line">Enzo</span>
                <span class="name-line">
                    Gubbiotti<span class="name-dot">.</span>
                </span>
            </h1>
            <p class="personal-role">
                {fr
                    ? 'Traileur auvergnat. Curieux de la suite.'
                    : 'Trail runner from Auvergne. Curious about what’s next.'}
            </p>
            <p class="personal-intro">
                {fr
                    ? 'Je cours sur les sentiers du Puy-de-Dôme, je prépare mes prochains défis et je partage ce que j’apprends en chemin.'
                    : 'I run the trails of Puy-de-Dôme, prepare for new challenges and share what I learn along the way.'}
            </p>
            <a class="personal-discover" href="#story">
                <span class="round-arrow">
                    <Icon name="chevron" size={22} />
                </span>
                <span>{fr ? 'Entrer dans mon univers' : 'Step into my world'}</span>
            </a>
        </div>
        <div class="hero-visual">
            <figure class="hero-portrait-frame">
                <img
                    src={sitePath('/images/trail/enzo-utmb-banner.webp')}
                    alt={
                        fr
                            ? 'Enzo Gubbiotti courant en montagne, sa bannière UTMB'
                            : 'Enzo Gubbiotti running in the mountains, his UTMB banner'
                    }
                    width="800"
                    height="450"
                    fetchpriority="high"
                />
                <figcaption>
                    <span>Enzo, {fr ? 'sur les sentiers.' : 'on the trails.'}</span>
                    <span>UTMB World</span>
                </figcaption>
            </figure>
        </div>
        <div class="personal-hero-footer">
            <span>Trail & ultra · Puy-de-Dôme, France</span>
            <a href="#goals">
                {fr ? 'Prochain chapitre : 2027' : 'Next chapter: 2027'}
                <Icon name="arrow" size={16} />
            </a>
        </div>
    </section>

    <section id="story" class="personal-story trail-wrap" aria-labelledby="story-heading">
        <div class="story-spread">
            <div class="story-sticky">
                <h2 id="story-heading">
                    {fr ? 'Derrière les kilomètres,' : 'Behind the miles,'}
                    <br />
                    <span>{fr ? 'il y a moi.' : 'there’s me.'}</span>
                </h2>
                <div class="story-photo-stack" aria-hidden="true">
                    <figure class="story-photo story-photo-home">
                        <img
                            src={sitePath('/images/trail/auvergne.webp')}
                            alt=""
                            width="1600"
                            height="1200"
                            loading="lazy"
                        />
                        <figcaption>{fr ? 'Mes terres' : 'My home ground'}</figcaption>
                    </figure>
                    <figure class="story-photo story-photo-person">
                        <img
                            src={sitePath('/images/trail/enzo.webp')}
                            alt=""
                            width="480"
                            height="480"
                            loading="lazy"
                        />
                        <figcaption>Enzo Gubbiotti</figcaption>
                    </figure>
                    <figure class="story-photo story-photo-run">
                        <img
                            src={sitePath(trailSocial.featuredPost.image)}
                            alt=""
                            width="405"
                            height="720"
                            loading="lazy"
                        />
                        <figcaption>
                            {fr ? 'La préparation, au quotidien' : 'The everyday preparation'}
                        </figcaption>
                    </figure>
                </div>
                <div class="story-chapter-indicator" aria-hidden="true">
                    <span>{fr ? 'Des racines' : 'The roots'}</span>
                    <span>{fr ? 'Un quotidien' : 'The everyday'}</span>
                    <span>{fr ? 'Une envie' : 'The ambition'}</span>
                </div>
            </div>
            <div class="story-chapters">
                <article class="story-chapter">
                    <h3>{fr ? 'Mon point de départ.' : 'Where it all starts.'}</h3>
                    <p>{copy.storyFirst}</p>
                    <span class="story-place">Puy-de-Dôme, Auvergne</span>
                </article>
                <article class="story-chapter">
                    <h3>{fr ? 'Entre code et sentiers.' : 'Between code and trails.'}</h3>
                    <p>{copy.storySecond}</p>
                    <a class="trail-text-link" href={sitePath(fr ? '/fr/' : '/')}>
                        {copy.developerLink}
                        <Icon name="arrow" size={17} />
                    </a>
                </article>
                <article class="story-chapter">
                    <h3>{fr ? 'L’envie d’aller plus loin.' : 'The drive to go further.'}</h3>
                    <p>{copy.intro}</p>
                    <a class="trail-text-link" href="#results">
                        {copy.resultsButton}
                        <Icon name="arrow" size={17} />
                    </a>
                </article>
            </div>
        </div>
    </section>

    <section class="home-loop" aria-labelledby="home-loop-title">
        <div class="home-loop-inner trail-wrap">
            <div class="home-loop-copy">
                <h2 id="home-loop-title">
                    {fr ? 'Tout part' : 'It all starts'}
                    <br />
                    <span>{fr ? 'de chez moi.' : 'at home.'}</span>
                </h2>
                <p>
                    {fr
                        ? 'Le GR441, c’est cette boucle autour de mes volcans. Début 2027, mon objectif est d’y tenter le meilleur temps connu avec assistance. Un projet personnel, sur les sentiers qui me ressemblent.'
                        : 'The GR441 loops around my home volcanoes. My goal is a supported fastest known time attempt here in early 2027. A personal project on the trails that feel like me.'}
                </p>
                <dl class="loop-facts">
                    <div>
                        <dt>{copy.distance}</dt>
                        <dd>114 km</dd>
                    </div>
                    <div>
                        <dt>{fr ? 'Dénivelé positif' : 'Elevation gain'}</dt>
                        <dd>2 782 m+</dd>
                    </div>
                    <div>
                        <dt>{copy.goal}</dt>
                        <dd>{gr441Project.timing[lang]}</dd>
                    </div>
                </dl>
                <a
                    class="trail-text-link"
                    href={sitePath(fr ? '/fr/trail/gr441/' : '/trail/gr441/')}
                >
                    {fr ? 'Découvrir mon projet' : 'Explore my project'}
                    <Icon name="arrow" size={18} />
                </a>
                <p class="loop-note">
                    {fr
                        ? 'Avec assistance · Date précise à définir.'
                        : 'Supported attempt · Exact date to be defined.'}
                </p>
            </div>
            <TrailRoute lang={lang} />
        </div>
    </section>

    <section id="goals" class="trail-projects" aria-labelledby="goals-heading">
        <div class="trail-wrap project-heading">
            <h2 id="goals-heading">
                2027.
                <br />
                <span>{fr ? 'Trois horizons.' : 'Three horizons.'}</span>
            </h2>
            <div>
                <p>{copy.goalsIntro}</p>
                <p class="trail-caption">{copy.goalsDisclaimer}</p>
                <a class="trail-text-link" href="#race-routes">
                    {fr ? 'UTLAC & Val d’Aran en 3D' : 'UTLAC & Val d’Aran in 3D'}
                    <Icon name="arrow" size={18} />
                </a>
            </div>
        </div>
        <div class="project-explorer trail-wrap">
            <div
                class="project-selector"
                aria-label={fr ? 'Explorer les projets 2027' : 'Explore the 2027 projects'}
            >
                {goals.map((goal) => (
                    <a class="project-choice" href={`#${goal.id}`} data-project-choice={goal.id}>
                        <span>{projectNames[goal.id]}</span>
                        <span class="project-choice-place">{goal.location}</span>
                        <Icon name="arrow" size={20} />
                    </a>
                ))}
            </div>
            <div class="project-panels">
                {goals.map((goal) => (
                    <article
                        class="project-panel"
                        id={goal.id}
                        aria-labelledby={`${goal.id}-title`}
                    >
                        <div class="project-landscape">
                            <img
                                src={sitePath(goal.image)}
                                alt={goal.imageAlt}
                                width={goal.id === 'gr441' ? '1600' : '1000'}
                                height={
                                    goal.id === 'gr441'
                                        ? '1200'
                                        : goal.id === 'miut'
                                          ? '721'
                                          : '669'
                                }
                                loading="lazy"
                            />
                            <span class="project-location">
                                <Icon name="mountain" size={18} />
                                {goal.location}
                            </span>
                        </div>
                        <div class="project-description">
                            <div class="project-title-line">
                                <h3 id={`${goal.id}-title`}>{goal.title}</h3>
                                <span class="project-status">
                                    {copy.goal} · {goal.timing}
                                </span>
                            </div>
                            <p class="project-distance">
                                {goal.distance}
                                <span>
                                    {fr ? goal.elevation.replace(',', ' ') : goal.elevation}
                                </span>
                            </p>
                            <p>{goal.description}</p>
                            <p class="project-partnership">
                                <strong>{copy.goalPartnershipLabel}</strong>
                                {goal.partnership}
                            </p>
                            <a
                                class="trail-action"
                                href={
                                    goal.id === 'gr441'
                                        ? sitePath(fr ? '/fr/trail/gr441/' : '/trail/gr441/')
                                        : goal.href
                                }
                                target={goal.id === 'gr441' ? undefined : '_blank'}
                                rel={goal.id === 'gr441' ? undefined : 'noreferrer'}
                            >
                                {goal.linkLabel}
                                <Icon name="arrow" size={20} />
                            </a>
                        </div>
                    </article>
                ))}
            </div>
        </div>
    </section>

    <RaceRoutes lang={lang} />

    <section id="results" class="trail-results trail-wrap" aria-labelledby="results-heading">
        <div class="results-heading">
            <h2 id="results-heading">
                {fr ? 'Quelques lignes' : 'A few'}
                <br />
                <span>{fr ? 'd’arrivée.' : 'finish lines.'}</span>
            </h2>
            <p>
                {fr
                    ? 'Des podiums Espoir. Un premier 114 km. Et beaucoup à construire.'
                    : 'Espoir podiums. A first 114 km finish. And plenty still to build.'}
            </p>
        </div>
        <div class="race-results">
            {highlights.map((result) => (
                <article class="race-result">
                    <div class="race-placing">
                        <strong>
                            {result.categoryPlacing
                                ? formatPlacing(result.categoryPlacing.place)
                                : '—'}
                        </strong>
                        <span>{result.categoryPlacing?.category}</span>
                    </div>
                    <div class="race-information">
                        <time datetime={result.dateIso}>{formatDate(result.dateIso)}</time>
                        <h3>{result.raceName}</h3>
                        <p>{result.note}</p>
                    </div>
                    <div class="race-numbers">
                        <span>
                            {Number(result.distance)} <small>km</small>
                        </span>
                        <span>{result.time}</span>
                        <span>
                            {result.rank} / {result.totalRanked} <small>{copy.overall}</small>
                        </span>
                    </div>
                </article>
            ))}
        </div>
        <details class="full-results">
            <summary>
                {copy.allResults} <Icon name="chevron" size={14} />
            </summary>
            <div id="utmb" class="results-index" aria-labelledby="utmb-heading">
                <div class="section-heading">
                    <h3 id="utmb-heading">UTMB Index</h3>
                    <a
                        class="text-link"
                        href={trailResults.profileUrl}
                        target="_blank"
                        rel="noreferrer"
                    >
                        {copy.viewProfile} <Icon name="arrow" size={14} />
                    </a>
                </div>
                <dl class="runner-indexes">
                    {trailResults.indexes.map((category) => (
                        <div class:list={{ 'index-overall': category.piCategory === 'general' }}>
                            <dt>{indexLabels[category.piCategory]}</dt>
                            <dd>
                                {category.index ?? (
                                    <span class="index-unrated">{copy.notRated}</span>
                                )}
                            </dd>
                        </div>
                    ))}
                </dl>
                <p class="source-note">
                    {copy.publishedProfile} ·{' '}
                    <time datetime={trailResults.retrievedAt}>
                        {formatDate(trailResults.retrievedAt)}
                    </time>
                </p>
            </div>
            <div
                class="results-table-scroll"
                tabindex="0"
                role="region"
                aria-label={copy.resultsRegion}
            >
                <table>
                    <caption>{copy.resultsCaption}</caption>
                    <thead>
                        <tr>
                            <th scope="col">{copy.race}</th>
                            <th scope="col">{copy.distance}</th>
                            <th scope="col">{copy.time}</th>
                            <th scope="col">{indexLabels.general}</th>
                            <th scope="col">{copy.category}</th>
                        </tr>
                    </thead>
                    <tbody>
                        {trailResults.results.map((result) => (
                            <tr>
                                <th scope="row">
                                    {result.raceName}
                                    <time datetime={result.dateIso}>
                                        {formatDate(result.dateIso)}
                                    </time>
                                </th>
                                <td>{Number(result.distance)} km</td>
                                <td>{result.isDnf ? copy.didNotFinish : result.time}</td>
                                <td>
                                    {result.isDnf ? '—' : `${result.rank} / ${result.totalRanked}`}
                                </td>
                                <td>
                                    {result.categoryPlacing
                                        ? `${formatPlacing(result.categoryPlacing.place)} · ${result.categoryPlacing.category}`
                                        : '—'}
                                </td>
                            </tr>
                        ))}
                    </tbody>
                </table>
            </div>
        </details>
        <p class="source-note">
            {copy.resultsSourceBefore}{' '}
            <a href={trailResults.profileUrl} target="_blank" rel="noreferrer">
                {copy.resultsSourceLink}
            </a>{' '}
            {copy.categorySource}
        </p>
    </section>

    <section id="content" class="trail-journal" aria-labelledby="content-heading">
        <div class="journal-inner trail-wrap">
            <div class="journal-copy">
                <h2 id="content-heading">
                    {fr ? 'Les coulisses,' : 'Behind the miles,'}
                    <br />
                    <span>{fr ? 'sur les sentiers.' : 'out on the trails.'}</span>
                </h2>
                <p class="trail-lead">{copy.contentIntro}</p>
                <a
                    class="trail-text-link"
                    href={trailSocial.profileUrl}
                    target="_blank"
                    rel="noreferrer"
                >
                    {trailSocial.name} / {trailSocial.handle}
                    <Icon name="arrow" size={20} />
                </a>
                <dl class="journal-audience">
                    <div>
                        <dd>{formatNumber(trailSocial.followers)}</dd>
                        <dt>{copy.followersLabel}</dt>
                    </div>
                    <div>
                        <dd>{trailSocial.likesDisplay[lang]}</dd>
                        <dt>{copy.likesLabel}</dt>
                    </div>
                </dl>
                <p class="trail-caption">
                    {copy.socialSnapshot}{' '}
                    <time datetime={trailSocial.retrievedAt}>
                        {formatDate(trailSocial.retrievedAt)}
                    </time>
                    .
                </p>
            </div>
            <a
                class="journal-video"
                href={trailSocial.featuredPost.url}
                target="_blank"
                rel="noreferrer"
                aria-label={`${trailSocial.featuredPost.title[lang]} · ${copy.watchPost}`}
            >
                <img
                    src={sitePath(trailSocial.featuredPost.image)}
                    alt={copy.featuredPostAlt}
                    width={trailSocial.featuredPost.width}
                    height={trailSocial.featuredPost.height}
                    loading="lazy"
                />
                <span class="journal-play">
                    <Icon name="play" size={24} />
                </span>
                <span class="journal-video-label">
                    <strong>{trailSocial.featuredPost.title[lang]}</strong>
                    <span>
                        {copy.watchPost}
                        <Icon name="arrow" size={18} />
                    </span>
                </span>
            </a>
        </div>
    </section>

    <section
        id="partnerships"
        class="trail-partnerships trail-wrap"
        aria-labelledby="partnerships-heading"
    >
        <div class="partnership-heading">
            <h2 id="partnerships-heading">
                {fr ? 'Une aventure' : 'An adventure'}
                <br />
                <span>{fr ? 'à partager.' : 'to share.'}</span>
            </h2>
            <div>
                <p class="trail-lead">{copy.partnershipIntro}</p>
                <a class="trail-text-link" href={partnershipHref}>
                    {copy.partnershipLink}
                    <Icon name="arrow" size={20} />
                </a>
            </div>
        </div>
        <div class="partnership-options">
            {copy.partnershipFormats.map((format) => (
                <details class="partnership-option">
                    <summary>
                        <h3>{format.title}</h3>
                        <span class="disclosure-mark" aria-hidden="true"></span>
                    </summary>
                    <dl>
                        <div>
                            <dt>{copy.supportLabel}</dt>
                            <dd>{format.support}</dd>
                        </div>
                        <div>
                            <dt>{copy.contributionLabel}</dt>
                            <dd>{format.contribution}</dd>
                        </div>
                    </dl>
                </details>
            ))}
        </div>
        <p class="source-note">{copy.partnershipNote}</p>
    </section>

    <section id="contact" class="trail-contact" aria-labelledby="trail-contact-heading">
        <div class="trail-wrap">
            <div class="contact-heading">
                <h2 id="trail-contact-heading">
                    {fr ? 'On écrit' : 'Let’s write'}
                    <br />
                    {fr ? 'la suite ?' : 'what’s next.'}
                </h2>
                <a class="contact-round" href={partnershipHref} aria-label={copy.emailAria}>
                    <Icon name="arrow" size={48} />
                </a>
            </div>
            <div class="contact-baseline">
                <p>{copy.contactIntro}</p>
                <a class="contact-email" href={partnershipHref}>
                    {profile.email}
                    <Icon name="arrow" size={22} />
                </a>
            </div>
            <div class="contact-socials">
                <a href={trailSocial.profileUrl} target="_blank" rel="noreferrer">
                    TikTok
                    <Icon name="arrow" size={16} />
                </a>
                <a href={trailResults.profileUrl} target="_blank" rel="noreferrer">
                    UTMB
                    <Icon name="arrow" size={16} />
                </a>
                <span>{fr ? 'À bientôt sur les sentiers.' : 'See you out on the trails.'}</span>
            </div>
        </div>
    </section>
    <div class="trail-wrap">
        <details class="trail-credits">
            <summary>{copy.creditsTitle}</summary>
            <p>
                {copy.creditsIntro}{' '}
                <a href={trailResults.profileUrl} target="_blank" rel="noreferrer">
                    {copy.creditsProfile}
                </a>
                .
            </p>
            <ul class="photographer-credits">
                <li>
                    Auvergne:{' '}
                    <a
                        href="https://commons.wikimedia.org/wiki/File:Panorama_Nord_-_Puy_de_dome.jpg"
                        target="_blank"
                        rel="noreferrer"
                    >
                        Thalia Gylonno
                    </a>
                    ·{' '}
                    <a
                        href="https://creativecommons.org/licenses/by-sa/2.0/"
                        target="_blank"
                        rel="noreferrer"
                    >
                        CC BY-SA 2.0
                    </a>
                    .
                </li>
                <li>
                    Madeira:{' '}
                    <a
                        href="https://commons.wikimedia.org/wiki/File:Pico_do_Arieiro.jpg"
                        target="_blank"
                        rel="noreferrer"
                    >
                        Markus Bernet
                    </a>
                    ·{' '}
                    <a
                        href="https://creativecommons.org/licenses/by-sa/2.0/"
                        target="_blank"
                        rel="noreferrer"
                    >
                        CC BY-SA 2.0
                    </a>
                    .
                </li>
                <li>
                    Réunion:{' '}
                    <a
                        href="https://commons.wikimedia.org/wiki/File:Mafate.jpg"
                        target="_blank"
                        rel="noreferrer"
                    >
                        Jdada42
                    </a>
                    ·{' '}
                    <a
                        href="https://creativecommons.org/licenses/by-sa/3.0/"
                        target="_blank"
                        rel="noreferrer"
                    >
                        CC BY-SA 3.0
                    </a>
                    .
                </li>
            </ul>
            <p>
                {copy.creditsProcessing}{' '}
                <a href={sitePath('/images/trail/SOURCES.md')}>{copy.fullCredits}</a>.
            </p>
            <p>
                {copy.creditsTiktok}{' '}
                <a href={trailSocial.featuredPost.url} target="_blank" rel="noreferrer">
                    TikTok · {trailSocial.name}
                </a>
                .
            </p>
            <p>
                {copy.raceDetails}{' '}
                <a
                    href="https://miutmadeira.com/miut-2027-regulations/"
                    target="_blank"
                    rel="noreferrer"
                >
                    MIUT 2027
                </a>{' '}
                ·{' '}
                <a
                    href="https://fastestknowntime.com/route/gr441-france"
                    target="_blank"
                    rel="noreferrer"
                >
                    {copy.fktSource}
                </a>{' '}
                ·{' '}
                <a href="https://www.grandraid-reunion.com/en/" target="_blank" rel="noreferrer">
                    Grand Raid Réunion
                </a>
                .
            </p>
        </details>
    </div>
</TrailLayout>

<script>
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    const choices = [...document.querySelectorAll<HTMLAnchorElement>('[data-project-choice]')];
    const panels = [...document.querySelectorAll<HTMLElement>('.project-panel')];
    const selector = document.querySelector('.project-selector');
    type Transition = { skipTransition: () => void; finished: Promise<void> };
    const transitionDocument = document as Document & {
        startViewTransition?: (update: () => void) => Transition;
    };
    let projectTransition: Transition | undefined;
    if (selector && choices.length === panels.length && choices.length > 0) {
        selector.setAttribute('role', 'tablist');
        choices.forEach((choice, index) => {
            const panel = panels[index];
            choice.setAttribute('role', 'tab');
            choice.id = `tab-${panel.id}`;
            choice.setAttribute('aria-controls', panel.id);
            panel.setAttribute('role', 'tabpanel');
            panel.setAttribute('aria-labelledby', choice.id);
            panel.tabIndex = 0;
        });
        const activate = (index: number, animate = false) => {
            const update = () => {
                choices.forEach((choice, i) => {
                    choice.setAttribute('aria-selected', String(i === index));
                    choice.tabIndex = i === index ? 0 : -1;
                    panels[i].hidden = i !== index;
                });
            };
            projectTransition?.skipTransition();
            if (animate && !reducedMotion.matches && transitionDocument.startViewTransition) {
                projectTransition = transitionDocument.startViewTransition(update);
                projectTransition.finished.catch(() => {});
            } else {
                update();
                if (animate && !reducedMotion.matches) {
                    panels[index]
                        .querySelector('img')
                        ?.animate([{ clipPath: 'inset(0 0 0 100%)' }, { clipPath: 'inset(0)' }], {
                            duration: 600,
                            easing: 'cubic-bezier(.16,1,.3,1)',
                        });
                }
            }
        };
        const fromHash = () => {
            const index = panels.findIndex((panel) => `#${panel.id}` === window.location.hash);
            if (index >= 0) activate(index);
        };
        choices.forEach((choice, index) => {
            choice.addEventListener('click', (event) => {
                event.preventDefault();
                activate(index, true);
                history.replaceState(null, '', `#${panels[index].id}`);
            });
            choice.addEventListener('keydown', (event) => {
                let next = index;
                if (event.key === 'ArrowRight') next = (index + 1) % choices.length;
                else if (event.key === 'ArrowLeft')
                    next = (index - 1 + choices.length) % choices.length;
                else if (event.key === 'Home') next = 0;
                else if (event.key === 'End') next = choices.length - 1;
                else return;
                event.preventDefault();
                activate(next, true);
                choices[next].focus();
            });
        });
        activate(0);
        fromHash();
        window.addEventListener('hashchange', fromHash);
    }

    const hero = document.querySelector<HTMLElement>('.personal-hero');
    const heroVisual = document.querySelector<HTMLElement>('.hero-visual');
    const portrait = document.querySelector<HTMLElement>('.hero-portrait-frame');
    const spread = document.querySelector<HTMLElement>('.story-spread');
    const chapters = [...document.querySelectorAll<HTMLElement>('.story-chapter')];
    const finePointer = window.matchMedia('(hover: hover) and (pointer: fine)');
    const clamp = (value: number) => Math.min(1, Math.max(0, value));
    let frame = 0;
    let pointerX = 0;
    let pointerY = 0;
    const entranceAnimations: Animation[] = [];
    const render = () => {
        frame = 0;
        if (document.hidden) return;
        if (reducedMotion.matches) {
            for (const element of [portrait, heroVisual])
                element?.style.removeProperty('transform');
            entranceAnimations.forEach((animation) => animation.cancel());
            return;
        }
        const height = window.innerHeight;
        const heroBox = hero?.getBoundingClientRect();
        if (heroBox && heroBox.bottom > 0 && heroBox.top < height) {
            const progress = clamp(-heroBox.top / heroBox.height);
            if (portrait) portrait.style.transform = `translateY(${-progress * 24}px)`;
            if (heroVisual)
                heroVisual.style.transform = `rotateY(${pointerX * 2}deg) rotateX(${-pointerY * 2}deg)`;
        }
        if (spread && chapters.length) {
            let nearest = 0;
            let distance = Infinity;
            chapters.forEach((chapter, index) => {
                const box = chapter.getBoundingClientRect();
                const nextDistance = Math.abs(box.top + box.height / 2 - height / 2);
                if (nextDistance < distance) {
                    nearest = index;
                    distance = nextDistance;
                }
            });
            spread.dataset.chapter = String(nearest);
        }
    };
    const schedule = () => {
        if (!frame) frame = requestAnimationFrame(render);
    };
    window.addEventListener('scroll', schedule, { passive: true });
    window.addEventListener('resize', schedule, { passive: true });
    reducedMotion.addEventListener('change', () => {
        projectTransition?.skipTransition();
        schedule();
    });
    document.addEventListener('visibilitychange', schedule);
    if (finePointer.matches && heroVisual) {
        heroVisual.addEventListener('pointermove', (event) => {
            const box = heroVisual.getBoundingClientRect();
            pointerX = ((event.clientX - box.left) / box.width - 0.5) * 2;
            pointerY = ((event.clientY - box.top) / box.height - 0.5) * 2;
            schedule();
        });
        heroVisual.addEventListener('pointerleave', () => {
            pointerX = 0;
            pointerY = 0;
            schedule();
        });
    }
    if (!reducedMotion.matches) {
        document.querySelectorAll('.name-line').forEach((line, index) => {
            entranceAnimations.push(
                line.animate(
                    [
                        { clipPath: 'inset(0 0 100% 0)', transform: 'translateY(12px)' },
                        { clipPath: 'inset(0)', transform: 'translateY(0)' },
                    ],
                    { duration: 850, delay: index * 100, easing: 'cubic-bezier(.16,1,.3,1)' },
                ),
            );
        });
        if (portrait)
            entranceAnimations.push(
                portrait.animate(
                    [
                        { opacity: 0, transform: 'translateY(22px)' },
                        { opacity: 1, transform: 'translateY(0)' },
                    ],
                    { duration: 1000, easing: 'cubic-bezier(.16,1,.3,1)' },
                ),
            );
    }
    schedule();
</script>
