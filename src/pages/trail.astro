---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import PixelPortrait from '../components/PixelPortrait.astro';
import { profile } from '../data/profile';
import { trailGoals } from '../data/trail';
import trailResults from '../data/trail-results.json';
import '../styles/trail.css';

const indexLabels: Record<string, string> = {
    general: 'Overall',
    '20k': '20K',
    '50k': '50K',
    '100k': '100K',
    '100m': '100M',
};
const highlights = [
    { date: '2026-08-08', note: 'Highest overall placing in my published results' },
    { date: '2026-06-12', note: 'My longest finish in the published results' },
    { date: '2025-10-11', note: 'An 82 km ultra on home ground' },
].map((highlight) => ({
    ...trailResults.results.find((result) => result.dateIso === highlight.date)!,
    note: highlight.note,
}));
const formatDate = (date: string) =>
    new Intl.DateTimeFormat('en-GB', {
        day: 'numeric',
        month: 'short',
        year: 'numeric',
        timeZone: 'UTC',
    }).format(new Date(date));
const formatNumber = (number: number) => new Intl.NumberFormat('en-GB').format(number);
---

<Layout
    mode="trail"
    title="Enzo Gubbiotti — Trail Runner from Auvergne"
    description="Trail runner from Puy-de-Dôme, Auvergne. My UTMB index, race results, and 2027 goals: MIUT Legend, a GR441 FKT attempt, and the Diagonale des Fous."
>
    <section class="hero trail-hero" aria-labelledby="trail-title">
        <div class="identity">
            <PixelPortrait src="/images/trail/enzo.webp" alt="Enzo Gubbiotti at a running event" />
            <div>
                <h1 id="trail-title">Enzo Gubbiotti</h1>
                <p class="runner-location">Puy-de-Dôme, Auvergne</p>
                <div class="socials">
                    <a
                        href={trailResults.profileUrl}
                        target="_blank"
                        rel="noreferrer"
                        aria-label="My official UTMB profile"
                    >
                        <Icon name="mountain" size={20} />
                    </a>
                    <a href={`mailto:${profile.email}`} aria-label="Email Enzo">
                        <Icon name="mail" size={20} />
                    </a>
                </div>
            </div>
        </div>
        <h2 class="hero-role">
            Trail runner <span>— rooted in Auvergne.</span>
        </h2>
        <p class="intro">
            I'm from the Puy-de-Dôme, and trail running is my passion. From the volcanoes at home to
            the islands I dream of crossing, I'm building towards longer adventures — and, one day,
            a life built around the sport I love.
        </p>
        <div class="trail-hero-actions">
            <a class="button primary" href="#goals">
                My 2027 goals <Icon name="chevron" size={14} />
            </a>
            <a class="text-link" href="#results">
                Race results <Icon name="arrow" size={15} />
            </a>
        </div>
        <figure class="home-landscape">
            <img
                src="/images/trail/auvergne.webp"
                alt="The Chaîne des Puys volcanoes stretching into the distance from Puy de Dôme"
                width="1600"
                height="1200"
                fetchpriority="high"
            />
            <figcaption>
                <span>Where it all starts.</span>
                <span>Chaîne des Puys · Auvergne</span>
            </figcaption>
        </figure>
    </section>

    <section id="utmb" data-reveal aria-labelledby="utmb-heading">
        <div class="section-heading">
            <h2 id="utmb-heading">UTMB Index</h2>
            <a class="text-link" href={trailResults.profileUrl} target="_blank" rel="noreferrer">
                View profile <Icon name="arrow" size={14} />
            </a>
        </div>
        <dl class="runner-indexes">
            {trailResults.indexes.map((category) => (
                <div class:list={{ 'index-overall': category.piCategory === 'general' }}>
                    <dt>{indexLabels[category.piCategory]}</dt>
                    <dd>{category.index ?? <span class="index-unrated">Not rated</span>}</dd>
                </div>
            ))}
        </dl>
        <p class="source-note">
            Published UTMB profile ·{' '}
            <time datetime={trailResults.retrievedAt}>{formatDate(trailResults.retrievedAt)}</time>
        </p>
    </section>

    <section id="results" data-reveal aria-labelledby="results-heading">
        <div class="section-heading">
            <h2 id="results-heading">On the finish line</h2>
            <span class="section-aside">Selected results</span>
        </div>
        <div class="race-results">
            {highlights.map((result) => (
                <article class="race-result">
                    <div class="race-date">
                        <time datetime={result.dateIso}>{formatDate(result.dateIso)}</time>
                    </div>
                    <div class="race-information">
                        <h3>{result.raceName}</h3>
                        <p class="race-event">{result.eventName}</p>
                        <p class="race-terrain">
                            {Number(result.distance)} km <span>/</span>{' '}
                            {formatNumber(result.elevationGain)} m+
                        </p>
                        <p class="result-context">{result.note}</p>
                    </div>
                    <div class="race-performance">
                        <p class="finish-time">{result.time}</p>
                        {result.categoryPlacing && (
                            <p>
                                <strong>
                                    {result.categoryPlacing.place} ·{' '}
                                    {result.categoryPlacing.category}
                                </strong>
                            </p>
                        )}
                        <p>
                            <strong>{result.rank}</strong> / {result.totalRanked} overall
                        </p>
                    </div>
                </article>
            ))}
        </div>
        <details class="full-results">
            <summary>
                View all published results <Icon name="chevron" size={14} />
            </summary>
            <div
                class="results-table-scroll"
                tabindex="0"
                role="region"
                aria-label="All published race results"
            >
                <table>
                    <caption>Race results and category placings</caption>
                    <thead>
                        <tr>
                            <th scope="col">Race</th>
                            <th scope="col">Distance</th>
                            <th scope="col">Time</th>
                            <th scope="col">Overall</th>
                            <th scope="col">Category</th>
                        </tr>
                    </thead>
                    <tbody>
                        {trailResults.results.map((result) => (
                            <tr>
                                <th scope="row">
                                    {result.raceName}
                                    <time datetime={result.dateIso}>
                                        {formatDate(result.dateIso)}
                                    </time>
                                </th>
                                <td>{Number(result.distance)} km</td>
                                <td>{result.isDnf ? 'Did not finish' : result.time}</td>
                                <td>
                                    {result.isDnf ? '—' : `${result.rank} / ${result.totalRanked}`}
                                </td>
                                <td>
                                    {result.categoryPlacing
                                        ? `${result.categoryPlacing.place} · ${result.categoryPlacing.category}`
                                        : '—'}
                                </td>
                            </tr>
                        ))}
                    </tbody>
                </table>
            </div>
        </details>
        <p class="source-note">
            Distances and overall rankings follow{' '}
            <a href={trailResults.profileUrl} target="_blank" rel="noreferrer">
                UTMB's published results
            </a>
            .
        </p>
    </section>

    <section id="goals" data-reveal aria-labelledby="goals-heading">
        <div class="section-heading">
            <h2 id="goals-heading">Three goals. One big year.</h2>
            <span class="year-label">2027</span>
        </div>
        <p class="body-copy goals-intro">
            Two islands and a challenge at home. These are the adventures I'm working towards.
        </p>
        <div class="trail-goals">
            {trailGoals.map((goal) => (
                <article class="trail-goal" id={goal.id}>
                    <a
                        class="goal-image"
                        href={goal.href}
                        target="_blank"
                        rel="noreferrer"
                        aria-label={goal.linkLabel}
                    >
                        <img
                            src={goal.image}
                            alt={goal.imageAlt}
                            width="1000"
                            height="750"
                            loading="lazy"
                        />
                        <span>{goal.location}</span>
                    </a>
                    <div class="goal-copy">
                        <div class="goal-heading">
                            <h3>{goal.title}</h3>
                            <span class="goal-status">Goal</span>
                        </div>
                        <p class="goal-timing">
                            {goal.timing} <span>·</span> {goal.type}
                        </p>
                        <p class="goal-distance">
                            {goal.distance} <span>/</span> {goal.elevation}
                        </p>
                        <p class="body-copy">{goal.description}</p>
                        <a class="text-link" href={goal.href} target="_blank" rel="noreferrer">
                            {goal.linkLabel} <Icon name="arrow" size={14} />
                        </a>
                    </div>
                </article>
            ))}
        </div>
        <p class="source-note">Personal goals, not confirmed entries. Race plans may evolve.</p>
    </section>

    <section id="story" data-reveal aria-labelledby="story-heading">
        <div class="section-heading">
            <h2 id="story-heading">From the volcanoes.</h2>
        </div>
        <div class="trail-story">
            <div class="story-copy">
                <p class="body-copy">
                    Auvergne is home. I'm from the Puy-de-Dôme, and its volcanic trails are part of
                    what makes running so personal to me. That connection is why the GR441 means
                    more than just another long distance.
                </p>
                <p class="body-copy">
                    Today, I work as a full-stack developer. But I'd love to make a living from
                    trail running one day. I want to keep progressing, take on the races that
                    inspire me, and see how far this passion can take me.
                </p>
                <a class="text-link" href="/">
                    Meet the developer <Icon name="arrow" size={14} />
                </a>
            </div>
            <div class="trail-principles">
                <div>
                    <h3>Home ground</h3>
                    <p>Puy-de-Dôme, Auvergne.</p>
                </div>
                <div>
                    <h3>The long game</h3>
                    <p>Keep learning. Keep moving.</p>
                </div>
                <div>
                    <h3>The dream</h3>
                    <p>Make a life out of trail running.</p>
                </div>
            </div>
        </div>
    </section>

    <section id="contact" data-reveal aria-labelledby="trail-contact-heading">
        <div class="section-heading">
            <h2 id="trail-contact-heading">Be part of the journey.</h2>
        </div>
        <div class="contact-grid">
            <p class="body-copy">
                A shared run, a project, or a partnership built around the outdoors — I'd love to
                connect with people who share this passion.
            </p>
            <div class="contact-links">
                <a
                    class="contact-card"
                    href={`mailto:${profile.email}?subject=Let's%20talk%20trail`}
                >
                    <span class="contact-icon">
                        <Icon name="mail" />
                    </span>
                    <span>
                        <small>Let's talk trail</small>
                        <span>{profile.email}</span>
                    </span>
                    <Icon name="chevron" size={16} />
                </a>
                <a
                    class="contact-card"
                    href={trailResults.profileUrl}
                    target="_blank"
                    rel="noreferrer"
                >
                    <span class="contact-icon">
                        <Icon name="mountain" />
                    </span>
                    <span>
                        <small>Follow my progress</small>
                        <span>My UTMB profile</span>
                    </span>
                    <Icon name="arrow" size={16} />
                </a>
            </div>
        </div>
    </section>
    <details class="trail-credits">
        <summary>Photography & sources</summary>
        <p>
            Landscape photographs illustrate my home region and future goals; they are not
            photographs of completed races. My portrait comes from my own{' '}
            <a href={trailResults.profileUrl} target="_blank" rel="noreferrer">
                UTMB profile
            </a>
            .
        </p>
        <ul class="photographer-credits">
            <li>
                Auvergne:{' '}
                <a
                    href="https://commons.wikimedia.org/wiki/File:Panorama_Nord_-_Puy_de_dome.jpg"
                    target="_blank"
                    rel="noreferrer"
                >
                    Thalia Gylonno
                </a>
                ·{' '}
                <a
                    href="https://creativecommons.org/licenses/by-sa/2.0/"
                    target="_blank"
                    rel="noreferrer"
                >
                    CC BY-SA 2.0
                </a>
                .
            </li>
            <li>
                Madeira:{' '}
                <a
                    href="https://commons.wikimedia.org/wiki/File:Pico_do_Arieiro.jpg"
                    target="_blank"
                    rel="noreferrer"
                >
                    Markus Bernet
                </a>
                ·{' '}
                <a
                    href="https://creativecommons.org/licenses/by-sa/2.0/"
                    target="_blank"
                    rel="noreferrer"
                >
                    CC BY-SA 2.0
                </a>
                .
            </li>
            <li>
                Réunion:{' '}
                <a
                    href="https://commons.wikimedia.org/wiki/File:Mafate.jpg"
                    target="_blank"
                    rel="noreferrer"
                >
                    Jdada42
                </a>
                ·{' '}
                <a
                    href="https://creativecommons.org/licenses/by-sa/3.0/"
                    target="_blank"
                    rel="noreferrer"
                >
                    CC BY-SA 3.0
                </a>
                .
            </li>
        </ul>
        <p>
            Images resized, converted to WebP, and cropped for display.{' '}
            <a href="/images/trail/SOURCES.md">Full image credits and adaptations</a>.
        </p>
        <p>
            Race details:{' '}
            <a
                href="https://miutmadeira.com/miut-2027-regulations/"
                target="_blank"
                rel="noreferrer"
            >
                MIUT 2027
            </a>{' '}
            ·{' '}
            <a
                href="https://fastestknowntime.com/route/gr441-france"
                target="_blank"
                rel="noreferrer"
            >
                GR441 on Fastest Known Time
            </a>{' '}
            ·{' '}
            <a href="https://www.grandraid-reunion.com/en/" target="_blank" rel="noreferrer">
                Grand Raid Réunion
            </a>
            .
        </p>
    </details>
</Layout>
